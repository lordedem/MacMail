{
  "name": "macmail",
  "version": "1.0.0",
  "description": "A high-performance Mac desktop email client with unified multi-account support and instant cross-account search",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder --mac dmg",
    "dist:all": "npm run build && electron-builder --mac",
    "dist:universal": "npm run build && electron-builder --mac dmg --universal",
    "dist:arm64": "npm run build && electron-builder --mac dmg --arm64",
    "dist:x64": "npm run build && electron-builder --mac dmg --x64"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.4",
    "imapflow": "^1.0.171",
    "lucide-react": "^1.16.0",
    "mailparser": "^3.7.2",
    "minisearch": "^7.1.3",
    "nodemailer": "^9.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.macmail.app",
    "productName": "MacMail",
    "copyright": "Copyright © 2026 MacMail",
    "asar": true,
    "directories": {
      "output": "dist-release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true,
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "MacMail ${version}",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
